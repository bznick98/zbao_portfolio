# Copy these server-only values into .env.local and your deployment settings.
# Never use a VITE_ prefix for credentials. No credentials belong in Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Optional comma-separated additional calendars to check for conflicts.
GOOGLE_BUSY_CALENDAR_IDS=
# Enable only after connecting Google and confirming these Pacific-time hours.
COFFEE_BOOKING_ENABLED=false
COFFEE_START_HOUR=10
COFFEE_END_HOUR=15
